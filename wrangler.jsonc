{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khocuahang",
  "main": "src/index.js",
  "compatibility_date": "2026-11-22",
  "vars": {
    "SAPO_ALIAS": "goldentech"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kho-cua-hang-db",
      "database_id": "c022697b-0b84-4447-8a10-ecdcbbd50fd6",
      "migrations_dir": "migrations"
    }
  ]
}
